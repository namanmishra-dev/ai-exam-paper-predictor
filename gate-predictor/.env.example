# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://gate:gate@localhost:5432/gate_predictor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM (Anthropic Claude) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL_ID=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.0

# ── Embeddings ────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Prediction Engine ────────────────────────────────
LAMBDA_DECAY=0.15
PRIORITY_WEIGHT_WEIGHTED_MARKS=0.45
PRIORITY_WEIGHT_TREND=0.20
PRIORITY_WEIGHT_GAP=0.15
PRIORITY_WEIGHT_CONSISTENCY=0.20
BUCKET_MUST_DO_PERCENT=60
BUCKET_SHOULD_DO_PERCENT=25

# ── Tagging ───────────────────────────────────────────
TAG_CONFIDENCE_THRESHOLD=0.75
TAGGING_BATCH_SIZE=10
TARGET_SUBJECT=operating_systems

# ── Ingestion ─────────────────────────────────────────
DEDUP_COSINE_THRESHOLD=0.95

# ── Celery ────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1

# ── Application ───────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
